# ============================================
# SignAI — .gitignore
# ============================================

# ---------- Python ----------
signai_env/
__pycache__/
*.py[cod]
*.pyo

# ---------- Dataset (too large for git) ----------
data/VIDEOS.zip
data/LANDMARKS/
data/IMU/
data/LSC50.pdf

# Documentación de tesis (archivos locales)
docs/*.pdf
docs/*.docx
Resources/docs/*.pdf
Resources/docs/*.docx

# Scripts de autor para Blender (no corren en el servidor)
scripts/export_avatar.py
scripts/setup_rig.py
scripts/retarget_blender.py
Resources/scripts/export_avatar.py
Resources/scripts/setup_rig.py
Resources/scripts/retarget_blender.py

# ---------- Runtime generated ----------
Resources/scripts/landmarks/
app/video_cache/

# ---------- Blender / MediaPipe ----------
assets/
blender/
Resources/scripts/hand_landmarker.task

# macOS metadata
.DS_Store
**/.DS_Store

# ---------- Unity (scoped to unity/SignAI/) ----------
# Cache / output (regenerated on first open or build)
unity/SignAI/Library/
unity/SignAI/Logs/
unity/SignAI/UserSettings/
unity/SignAI/TempArtifacts/
unity/SignAI/Builds/
unity/SignAI/.utmp/
unity/SignAI/.vscode/
*.apk
*.aab

# Unity-generated IDE files (regenerated by Unity)
*.csproj
*.sln

# ---------- Gradle / Kotlin / Android ----------
.gradle/
.kotlin/
build/
bin/
local.properties
*.iml
.idea/
*.hprof

# Unity temp
unity/SignAI/Temp/

# ---------- OS junk ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- Editor swap files ----------
*.swp
*.swo
*~
*.bak

# ---------- Claude Code ----------
.claude/
