# ============================================
# SignAI — .gitignore
# ============================================

# ---------- Python ----------
signai_env/
__pycache__/
*.py[cod]
*.pyo

# ---------- Dataset (too large for git) ----------
data/VIDEOS.zip
data/LANDMARKS/
data/IMU/

# ---------- Runtime generated ----------
Resources/scripts/landmarks/
app/video_cache/

# ---------- Blender / MediaPipe ----------
assets/
blender/*.blend
blender/*.blend1
blender/RiS_StartFiles_v2.zip
blender/RiS_StartFiles_v2/
Resources/scripts/hand_landmarker.task

# ---------- Unity (scoped to unity/SignAI/) ----------
# Cache / output (regenerated on first open or build)
unity/SignAI/Library/
unity/SignAI/Logs/
unity/SignAI/UserSettings/
unity/SignAI/TempArtifacts/
unity/SignAI/Builds/
unity/SignAI/.utmp/
unity/SignAI/.vscode/
*.apk
*.aab

# Unity-generated IDE files (regenerated by Unity)
*.csproj
*.sln

# ---------- Gradle / Kotlin / Android ----------
.gradle/
.kotlin/
build/
local.properties
*.iml
.idea/
*.hprof

# ---------- OS junk ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- Editor swap files ----------
*.swp
*.swo
*~
*.bak

# ---------- Claude Code ----------
.claude/
